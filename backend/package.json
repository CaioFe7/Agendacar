{
  "name": "agendacar-backend",
  "version": "1.0.0",
  "description": "Backend Node.js + Express + Sequelize para o AgendaCar",
 "main": "dist/server.js",
"scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "start:prod": "npm run build && node dist/seeders/seedCarros.js && node dist/seeders/seedAdmin.js && node dist/server.js",
  "seed": "node src/seeders/seedCarros.js && node src/seeders/seedAdmin.js"
},
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "natural": "^6.12.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
